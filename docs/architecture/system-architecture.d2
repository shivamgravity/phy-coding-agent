# ============================================================
# CONNECTIONS
# ============================================================

user -> request
request -> repository
repository -> strategy

strategy -> approval

approval -> strategy: "Revise / Reject"
approval -> planning: "Approved"

planning -> execution
execution -> verification

verification -> report: "Success"
verification -> debug: "Issue Found"

debug -> context: "Need More Context"
debug -> solution: "Solution Required"

context -> repository
solution -> strategy